{
  "name": "@x71-agentkit/agentkit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Local-first safety gates, MCP auditing, project scanning, and AI cost controls for agentic development workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alkatheeri24/X71-AgentKit.git"
  },
  "homepage": "https://github.com/Alkatheeri24/X71-AgentKit#readme",
  "bugs": {
    "url": "https://github.com/Alkatheeri24/X71-AgentKit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "x71-agentkit": "src/cli.mjs"
  },
  "exports": {
    "./agentops-guard": "./src/agentops-guard.mjs",
    "./mcp-auditor": "./src/mcp-auditor.mjs",
    "./ai-cost-guard": "./src/ai-cost-guard.mjs",
    "./project-scanner": "./src/project-scanner.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check src/agentops-guard.mjs && node --check src/mcp-auditor.mjs && node --check src/ai-cost-guard.mjs && node --check src/project-scanner.mjs && node --check src/cli.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "ai-agents",
    "agent-security",
    "mcp",
    "security",
    "agentops",
    "llm",
    "cost-control",
    "git-safety",
    "claude-code",
    "codex",
    "cursor"
  ]
}
